{
  "name": "ocearo-core",
  "version": "1.2.1",
  "description": "Ocearo Core — the voice of the boat for Signal K: COLREG collision watch, anchor watch, offline SHOM bathymetry, weather, engine and battery monitoring, sail coaching and logbook, spoken through local TTS with an optional local LLM",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "lint": "eslint .",
    "prepack": "node ../scripts/prepare-npm-package.mjs",
    "postpack": "node ../scripts/prepare-npm-package.mjs --clean"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-notifications",
    "signalk-category-ais",
    "signalk-category-weather",
    "signalk-category-utility",
    "signalk",
    "marine",
    "navigation",
    "sailing",
    "colregs",
    "ais",
    "anchor-watch",
    "bathymetry",
    "weather",
    "tides",
    "logbook",
    "tts",
    "piper",
    "ollama",
    "llm",
    "raspberry-pi",
    "ocearo"
  ],
  "author": {
    "name": "Matthieu Laborie",
    "email": "laborima@users.noreply.github.com",
    "url": "https://github.com/laborima"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laborima/ocearo-core.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/laborima/ocearo-core/issues"
  },
  "homepage": "https://github.com/laborima/ocearo-core#readme",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/laborima"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "signalk-plugin-enabled-by-default": false,
  "signalkPlugin": {
    "id": "ocearo-core",
    "name": "Océaro Core",
    "description": "The voice of the boat: COLREG collision watch, anchor watch, SHOM bathymetry, weather, engine and battery monitoring, sail coaching and logbook, spoken aloud"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "index.js",
    "schema.json",
    "src/",
    "config/",
    "scripts/",
    "icons/",
    "test/",
    "README.md",
    "README.fr.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "signalk": {
    "displayName": "Océaro Core",
    "appIcon": "./icons/ocearo-core.webp",
    "screenshots": [
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/colregs.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/anchor.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/traffic.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/logbook.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/engine.jpg",
      "https://raw.githubusercontent.com/laborima/ocearo-ui/main/docs/screenshots/weather.jpg"
    ],
    "recommends": [
      "ocearo-ui"
    ]
  }
}
